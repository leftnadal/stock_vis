<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.stockvis.celery-worker-neo4j</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/byeongjinjeong/worktrees/sv-worker-runtime/scripts/celery-worker-neo4j.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/byeongjinjeong/Library/Logs/stockvis/celery-worker-neo4j-error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/byeongjinjeong/Library/Logs/stockvis/celery-worker-neo4j.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/byeongjinjeong/worktrees/sv-worker-runtime</string>
</dict>
</plist>
